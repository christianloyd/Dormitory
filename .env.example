# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dorm_db

# SMS API Configuration (IPROG)
# Set SMS_ENABLED to false to disable SMS sending
SMS_ENABLED=true
SMS_API_URL=https://sms.iprogtech.com/api/v1/sms_messages
SMS_API_TOKEN=your_iprog_api_token_here
SMS_SENDER=BEN & SOF Dormitory

# Instructions:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Replace "your_iprog_api_token_here" with your actual IPROG API token
# 3. Update database credentials if different from defaults
# 4. Never commit .env to version control (it's in .gitignore)
